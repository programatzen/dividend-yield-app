# Copia a .env.local y completa con tus valores (nunca commitear secretos).
# Se obtienen en Supabase Dashboard → Project Settings → API.

# URL del proyecto (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# API Key "anon public" (Project Settings → API → API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# NOTA: el Client ID y Client Secret de Google NO van aquí.
# Se pegan en Supabase Dashboard → Authentication → Providers → Google.
